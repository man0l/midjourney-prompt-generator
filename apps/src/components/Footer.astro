        </a>
        <a href="https://www.toolpilot.ai" target="_blank" rel="noopener">
          <img src="https://www.toolpilot.ai/cdn/shop/files/f-b_690x151_crop_center.png" alt="Featured on ToolPilot" width="200" height="44" class="h-10 w-auto" />
        </a>
        <a href="https://showmebest.ai" target="_blank" rel="noopener">
          <img src="https://showmebest.ai/badge/feature-badge-dark.webp" alt="Featured on ShowMeBestAI" width="220" height="60" class="h-10 w-auto" />
        </a>
        <a href="https://whatsthebigdata.com/ai-tools/" target="_blank" rel="noopener" title="Whatsthebigdata AI Tools Directory">
          <img src="https://whatsthebigdata.com/badges/featured-on-whatsthebigdata-dark.png" alt="Featured on Whatsthebigdata" width="240" class="h-10 w-auto" />
        </a>
        <a href="https://dofollow.tools" target="_blank" rel="noopener noreferrer">
          <img src="https://dofollow.tools/badge/badge_dark.svg" alt="Featured on Dofollow.Tools" width="200" height="54" loading="lazy" class="h-10 w-auto" />
        </a>
        <a href="https://acidtools.com/ai/midjourney-prompt-generator" target="_blank" rel="noopener">
          <img src="https://acidtools.com/assets/images/badge-dark.png" alt="Featured on Acid Tools" class="h-10 w-auto" />
        </a>
        <a href="https://ufind.best" target="_blank" rel="noopener">
          <img src="https://ufind.best/img/logo.svg?v=20260816b" alt="Ufind.best" width="32" height="32" class="h-8 w-8" />
        </a>
        <a href="https://www.tinystartups.com/?utm_source=badge" target="_blank" rel="noopener">
          <img src="https://cdn.prod.website-files.com/657b3d8ca1cab4015f06c850/68015a2ee966c186c789d4d3_21.png" alt="Launched on Tiny Startups" class="h-10 w-auto" />
        </a>
      </div>
      <p class="text-xs text-[#9a9080] space-x-3">
        <a href="https://mossai.org" title="MossAI Tools" class="text-[#9a9080] hover:text-[#f0b429]">MossAI Tools</a>
        <a href="https://auraplusplus.com" title="Aura++" target="_blank" rel="noopener" class="text-[#9a9080] hover:text-[#f0b429]">Aura++</a>
        <a href="https://yo.directory" target="_blank" rel="noopener" class="text-[#9a9080] hover:text-[#f0b429]">Yo.directory</a>
        <a href="https://wired.business" target="_blank" rel="noopener" class="text-[#9a9080] hover:text-[#f0b429]">Wired Business</a>
        <a href="https://deeplaunch.io" target="_blank" rel="noopener" class="text-[#9a9080] hover:text-[#f0b429]">DeepLaunch</a>
        <a href="https://toolfame.com" target="_blank" rel="noopener" class="text-[#9a9080] hover:text-[#f0b429]">ToolFame</a>
        <a href="https://saasfame.com" target="_blank" rel="noopener" class="text-[#9a9080] hover:text-[#f0b429]">SaaSFame</a>
        <a href="https://www.startupfa.st" target="_blank" rel="noopener" class="text-[#9a9080] hover:text-[#f0b429]">Startup Fast</a>
        <a href="https://newtool.site" target="_blank" rel="noopener" class="text-[#9a9080] hover:text-[#f0b429]">NewTool</a>
        <a href="https://startupbase.io" target="_blank" rel="noopener" class="text-[#9a9080] hover:text-[#f0b429]">StartupBase</a>
        <a href="https://aiagentsdirectory.com" target="_blank" rel="noopener" class="text-[#9a9080] hover:text-[#f0b429]">AI Agents Directory</a>
