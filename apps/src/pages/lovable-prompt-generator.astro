---
import Layout from '../layouts/Layout.astro';
import SimplePromptTool from '../components/SimplePromptTool';

import PricingSection from '../components/PricingSection';

Astro.response.headers.set('Cache-Control', 's-maxage=300, stale-while-revalidate=3600');
---
<Layout
  title="Free Lovable Prompt Generator — Build Full Apps with Lovable"
  description="Generate perfectly crafted Lovable prompts from your app idea. Free generator that builds the system prompt, architecture specs, and design standards Lovable needs. No sign-up."
>
  <!-- Hero Section -->
  <section class="px-6 pt-14 pb-10 text-center border-b-2 border-[#1c1c1c]">
    <h1 class="text-5xl font-bold text-[#1a1a1a] leading-tight mb-5">Lovable Prompt Generator</h1>
    <p class="text-[#6b6559] text-lg max-w-2xl mx-auto mb-8 leading-relaxed">
      Turn your app ideas into perfectly crafted lovable prompts that generate fully-functional applications with minimal debugging. Our free lovable prompt generator adds architecture specs, design standards, and technical requirements that Lovable needs to build production-ready apps.
    </p>
    <a href="#root" class="inline-block px-10 py-4 bg-[#f0b429] border-2 border-[#1c1c1c] rounded-xl font-bold text-[#1a1a1a] text-lg hover:brightness-95 transition-all">
      Generate Lovable Prompt — Free
    </a>
    <p class="text-[#6b6559] text-sm mt-3">3 free generations per day — no credit card required</p>
  </section>

  <div id="root">
    <SimplePromptTool
      client:only="react"
      seoTitle="Lovable Prompt Generator"
      seoDescription="Generate Lovable prompts that build complete apps."
      inputPlaceholder="Describe your app idea... e.g. a project management tool for freelancers with task tracking and invoicing"
      buttonLabel="Generate Lovable Prompt"
      toolType="lovable"
    />
  </div>

  <div class="px-6 py-12 space-y-6">
    

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="border border-[#c8c0a8] rounded-xl p-6">
        <h3 class="text-lg font-bold text-[#1a1a1a] mb-3">Why Use a Lovable Prompt Generator?</h3>
        <p class="text-[#6b6559] text-sm leading-relaxed">
          Lovable prompts that work aren't just descriptions — they're structured specifications. Our lovable prompt generator automatically adds React + TypeScript requirements, Tailwind/shadcn/ui design standards, accessibility rules, and quality constraints that turn your simple idea into a prompt Lovable can build completely and correctly. Think of each output as your own Lovable prompt bible — a complete system prompt covering stack, design, features, and constraints in one copy-paste.
</p>
      </div>
      <div class="border border-[#c8c0a8] rounded-xl p-6">
        <h3 class="text-lg font-bold text-[#1a1a1a] mb-4">What Gets Added to Your Lovable Prompts</h3>
        <div class="space-y-3">
          <div class="flex items-start gap-2"><span class="mt-0.5">🏗️</span><p class="text-[#6b6559] text-sm">Architecture: React, TypeScript, component structure</p></div>
          <div class="flex items-start gap-2"><span class="mt-0.5">🎨</span><p class="text-[#6b6559] text-sm">Design: Tailwind CSS, shadcn/ui, responsive layout</p></div>
          <div class="flex items-start gap-2"><span class="mt-0.5">✅</span><p class="text-[#6b6559] text-sm">Quality: No placeholder code, production-ready standards</p></div>
          <div class="flex items-start gap-2"><span class="mt-0.5">♿</span><p class="text-[#6b6559] text-sm">Accessibility: ARIA labels, keyboard navigation</p></div>
        </div>
      </div>
    </div>

    <div class="border border-[#c8c0a8] rounded-xl p-6">
      <h2 class="text-xl font-bold text-[#1a1a1a] mb-3">Every Output Is a Complete Lovable System Prompt</h2>
      <p class="text-[#6b6559] text-sm leading-relaxed">
        Most lovable prompts fail because they describe an idea without specifying how to build it. This generator produces a full Lovable system prompt — not a vague request, but a structured spec with component architecture, design tokens, accessibility requirements, and production constraints already written in. Paste it directly into Lovable and build.
      </p>
    </div>

    <div class="border border-[#c8c0a8] rounded-xl p-6">
      <h3 class="text-lg font-bold text-[#1a1a1a] mb-4">Frequently Asked Questions</h3>
      <div class="space-y-4">
        <div>
          <p class="font-semibold text-[#1a1a1a] text-sm">Is this Lovable prompt generator free?</p>
          <p class="text-[#6b6559] text-xs mt-1">Yes — free, no sign-up. Generate as many lovable prompts as you need.</p>
        </div>
        <div>
          <p class="font-semibold text-[#1a1a1a] text-sm">What makes a good Lovable prompt?</p>
          <p class="text-[#6b6559] text-xs mt-1">Lovable prompts need to specify tech stack, design system, feature list, and quality standards. Our generator adds all of these automatically from your plain-language description.</p>
        </div>
        <div>
          <p class="font-semibold text-[#1a1a1a] text-sm">Can I edit the generated Lovable prompt?</p>
          <p class="text-[#6b6559] text-xs mt-1">Yes — copy the result and tweak it before pasting into Lovable. Add specific features, change the tech stack, or adjust the design requirements.</p>
        </div>
        <div>
          <p class="font-semibold text-[#1a1a1a] text-sm">What is a Lovable system prompt?</p>
          <p class="text-[#6b6559] text-xs mt-1">A Lovable system prompt is the structured instruction set that tells Lovable exactly what to build — covering tech stack, design standards, component architecture, and quality constraints in one block. Without these specifications, Lovable fills in gaps with defaults that often need debugging. This generator builds your system prompt automatically from plain-language input, so Lovable has everything it needs from the first message.</p>
        </div>
        <div>
          <p class="font-semibold text-[#1a1a1a] text-sm">What is the Lovable prompt bible?</p>
          <p class="text-[#6b6559] text-xs mt-1">The Lovable prompt bible refers to the set of patterns and specifications that experienced Lovable builders use to get consistent, production-ready results — things like always specifying React + TypeScript, defining the shadcn/ui design system, and including quality constraints. This generator has that knowledge built in, so every lovable prompt you generate already follows best practices without you needing to memorise the spec.</p>
        </div>
      </div>
    </div>

    <a href="#root" class="block w-full py-4 bg-[#f0b429] border-2 border-[#1c1c1c] rounded-xl text-center font-bold text-[#1a1a1a] text-lg hover:brightness-95 transition-all">
      Generate Your Lovable Prompt
    </a>
  </div>

    <PricingSection client:load priceIds={{
      starterMonthly: import.meta.env.STRIPE_PRICE_STARTER_MONTHLY,
      starterYearly: import.meta.env.STRIPE_PRICE_STARTER_YEARLY,
      proMonthly: import.meta.env.STRIPE_PRICE_PRO_MONTHLY,
      proYearly: import.meta.env.STRIPE_PRICE_PRO_YEARLY,
      unlimitedMonthly: import.meta.env.STRIPE_PRICE_UNLIMITED_MONTHLY,
      unlimitedYearly: import.meta.env.STRIPE_PRICE_UNLIMITED_YEARLY,
    }} />
</Layout>
