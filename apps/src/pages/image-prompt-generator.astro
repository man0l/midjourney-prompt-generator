---
import Layout from '../layouts/Layout.astro';
import SimplePromptTool from '../components/SimplePromptTool';

import PricingSection from '../components/PricingSection';

Astro.response.headers.set('Cache-Control', 's-maxage=300, stale-while-revalidate=3600');
---

<Layout
  title="Free Image Prompt Generator — Text to Image Prompts for Midjourney, DALL·E & ChatGPT"
  description="Free image prompt generator — no sign-up required. Turn any plain description into a structured text to image prompt with style, lighting, camera angle, and quality parameters. Works with Midjourney, DALL·E, ChatGPT, Stable Diffusion, and Gemini."
>
  <!-- Hero Section -->
  <section class="px-6 pt-14 pb-10 text-center border-b-2 border-[#1c1c1c]">
    <h1 class="text-5xl font-bold text-[#1a1a1a] leading-tight mb-5">Image Prompt Generator</h1>
    <p class="text-[#6b6559] text-lg max-w-2xl mx-auto mb-8 leading-relaxed">
      An image prompt generator takes your plain description and builds a structured prompt packed with style, lighting, camera angle, mood, and technical parameters — everything AI image tools need to generate exactly what you have in mind. Works as a free text to image prompt generator for Midjourney, ChatGPT, DALL·E, Stable Diffusion, and Gemini.
    </p>
    <a href="#root" class="inline-block px-10 py-4 bg-[#f0b429] border-2 border-[#1c1c1c] rounded-xl font-bold text-[#1a1a1a] text-lg hover:brightness-95 transition-all">
      Generate Image Prompt — Free
    </a>
    <p class="text-[#6b6559] text-sm mt-3">3 free generations per day — no credit card required</p>
  </section>

  <div id="root">
    <SimplePromptTool
      client:only="react"
      seoTitle="Image Prompt Generator"
      seoDescription="Turn your plain description into a structured image prompt with style, lighting, camera, and quality parameters."
      inputPlaceholder="Describe the image you want to generate... e.g. a cinematic portrait of an astronaut exploring a neon-lit jungle at dusk, photorealistic, 8K"
      buttonLabel="Generate Image Prompt"
      toolType="image"
    />
  </div>

  <div class="px-6 py-12 space-y-6">

    <!-- H2 #1: What does an image prompt generator add? -->
    <div class="border border-[#c8c0a8] rounded-xl p-6">
      <h2 class="text-lg font-bold text-[#1a1a1a] mb-3">What does an image prompt generator add?</h2>
      <p class="text-[#6b6559] text-sm leading-relaxed mb-4">
        An image prompt generator takes your basic idea and adds the structured details AI image models need: art style, lighting, camera angle, colour palette, mood, and technical parameters like resolution and aspect ratio.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-[#f5f0e8] rounded-lg p-4">
          <p class="text-xs font-semibold text-[#9a9080] uppercase mb-2">Before</p>
          <p class="text-sm text-[#6b6559] italic">"A portrait of an astronaut in a jungle."</p>
        </div>
        <div class="bg-[#f5f0e8] rounded-lg p-4">
          <p class="text-xs font-semibold text-[#1a1a1a] uppercase mb-2">After</p>
          <p class="text-sm text-[#6b6559] italic">"A portrait of an astronaut in a jungle. Art style: photorealistic, cinematic. Lighting: golden hour, dramatic shadows. Camera: 35mm lens, shallow depth of field. Mood: immersive, breathtaking. Quality: 8K, 16:9, Unreal Engine 5."</p>
        </div>
      </div>
    </div>

    <!-- H2 #2: What gets added — 4-card grid -->
    <div class="border border-[#c8c0a8] rounded-xl p-6">
      <h2 class="text-lg font-bold text-[#1a1a1a] mb-4">What gets added to your image prompt</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-[#f5f0e8] rounded-lg p-4">
          <p class="font-semibold text-[#1a1a1a] text-sm mb-1">🎨 Art style & medium</p>
          <p class="text-[#6b6559] text-xs leading-relaxed">Photorealistic, oil painting, anime, cinematic, watercolour — matched to your subject for consistent output.</p>
        </div>
        <div class="bg-[#f5f0e8] rounded-lg p-4">
          <p class="font-semibold text-[#1a1a1a] text-sm mb-1">💡 Lighting & mood</p>
          <p class="text-[#6b6559] text-xs leading-relaxed">Golden hour, studio lighting, dramatic shadows, neon glow — the atmosphere that makes an image feel intentional.</p>
        </div>
        <div class="bg-[#f5f0e8] rounded-lg p-4">
          <p class="font-semibold text-[#1a1a1a] text-sm mb-1">📷 Camera & composition</p>
          <p class="text-[#6b6559] text-xs leading-relaxed">Angle, lens type, depth of field, rule of thirds — the technical framing that separates amateur from cinematic.</p>
        </div>
        <div class="bg-[#f5f0e8] rounded-lg p-4">
          <p class="font-semibold text-[#1a1a1a] text-sm mb-1">⚙️ Quality parameters</p>
          <p class="text-[#6b6559] text-xs leading-relaxed">Resolution, aspect ratio, rendering engine — ensures the output is usable at the quality your project demands.</p>
        </div>
      </div>
    </div>

    <!-- H2 #3: Internal linking hub -->
    <div class="border border-[#c8c0a8] rounded-xl p-6">
      <h2 class="text-lg font-bold text-[#1a1a1a] mb-3">Image prompt generators for every AI tool</h2>
      <p class="text-[#6b6559] text-sm leading-relaxed mb-4">
        Different AI image tools respond best to different prompt structures. Use the model-specific generator for best results — each one is tuned to the quirks of its target model.
      </p>
      <div class="space-y-3">
        <a href="/" class="flex items-center justify-between p-3 bg-[#f5f0e8] rounded-lg hover:bg-[#ede8d8] transition-colors">
          <div>
            <p class="font-semibold text-[#1a1a1a] text-sm">Midjourney image prompt generator</p>
            <p class="text-[#6b6559] text-xs mt-0.5">Prompts tuned for Midjourney's artistic rendering and --parameter syntax</p>
          </div>
          <span class="text-[#9a9080] text-xs">→</span>
        </a>
        <a href="/chatgpt-image-prompt-generator" class="flex items-center justify-between p-3 bg-[#f5f0e8] rounded-lg hover:bg-[#ede8d8] transition-colors">
          <div>
            <p class="font-semibold text-[#1a1a1a] text-sm">ChatGPT image prompt generator</p>
            <p class="text-[#6b6559] text-xs mt-0.5">Structured prompts for ChatGPT-4o and DALL·E 3</p>
          </div>
          <span class="text-[#9a9080] text-xs">→</span>
        </a>
        <a href="/gemini-prompt-generator" class="flex items-center justify-between p-3 bg-[#f5f0e8] rounded-lg hover:bg-[#ede8d8] transition-colors">
          <div>
            <p class="font-semibold text-[#1a1a1a] text-sm">Gemini image prompt generator</p>
            <p class="text-[#6b6559] text-xs mt-0.5">Prompts optimised for Google Gemini's multimodal generation</p>
          </div>
          <span class="text-[#9a9080] text-xs">→</span>
        </a>
        <a href="/grok-prompt-generator" class="flex items-center justify-between p-3 bg-[#f5f0e8] rounded-lg hover:bg-[#ede8d8] transition-colors">
          <div>
            <p class="font-semibold text-[#1a1a1a] text-sm">Grok image prompt generator</p>
            <p class="text-[#6b6559] text-xs mt-0.5">Prompts built for Grok's direct, high-detail image outputs</p>
          </div>
          <span class="text-[#9a9080] text-xs">→</span>
        </a>
      </div>
    </div>

    <!-- FAQ -->
    <div class="border border-[#c8c0a8] rounded-xl p-6">
      <h2 class="text-lg font-bold text-[#1a1a1a] mb-4">Frequently Asked Questions</h2>
      <div class="space-y-4">
        <div>
          <p class="font-semibold text-[#1a1a1a] text-sm">What is an image prompt generator?</p>
          <p class="text-[#6b6559] text-xs mt-1">An image prompt generator takes a plain description and transforms it into a structured prompt with art style, lighting, camera angle, and quality settings that AI image models need to produce accurate, high-quality results.</p>
        </div>
        <div>
          <p class="font-semibold text-[#1a1a1a] text-sm">Is this image prompt generator free?</p>
          <p class="text-[#6b6559] text-xs mt-1">Yes — completely free, no sign-up required. This free image prompt generator runs entirely in your browser. Generate unlimited prompts with no account needed.</p>
        </div>
        <div>
          <p class="font-semibold text-[#1a1a1a] text-sm">Does it work as a text to image prompt generator?</p>
          <p class="text-[#6b6559] text-xs mt-1">Yes. Describe your image in plain text and the tool builds a structured text to image prompt with all the parameters AI models need. Just type what you want to see — the generator handles the technical detail.</p>
        </div>
        <div>
          <p class="font-semibold text-[#1a1a1a] text-sm">Does it work with ChatGPT, Midjourney, and DALL·E?</p>
          <p class="text-[#6b6559] text-xs mt-1">Yes — this image prompt generator is model-agnostic. The structured output works with Midjourney, ChatGPT-4o, DALL·E 3, Stable Diffusion, Gemini, and Grok. For model-specific tuning, see the <a href="/chatgpt-image-prompt-generator" class="text-[#1a1a1a] underline hover:no-underline">ChatGPT image prompt generator</a>.</p>
        </div>
        <div>
          <p class="font-semibold text-[#1a1a1a] text-sm">What's the difference between an image prompt and a text prompt?</p>
          <p class="text-[#6b6559] text-xs mt-1">A text prompt asks an AI to write or reason — it needs role, task, context, and format. An image prompt asks an AI to generate a visual — it needs style, lighting, composition, and quality parameters. For text prompts, use our <a href="/prompt-builder" class="text-[#1a1a1a] underline hover:no-underline">prompt builder</a>.</p>
        </div>
      </div>
    </div>

    <!-- Bottom CTA -->
    <a href="#root" class="block w-full py-4 bg-[#f0b429] border-2 border-[#1c1c1c] rounded-xl text-center font-bold text-[#1a1a1a] text-lg hover:brightness-95 transition-all">
      Generate Your Image Prompt
    </a>

    <div class="text-center text-xs text-[#6b6559] pb-2">
      Also try: <a href="/chatgpt-image-prompt-generator" class="text-[#1a1a1a] underline hover:no-underline">ChatGPT Image Prompt Generator</a> · <a href="/gemini-prompt-generator" class="text-[#1a1a1a] underline hover:no-underline">Gemini Prompt Generator</a> · <a href="/prompt-builder" class="text-[#1a1a1a] underline hover:no-underline">Prompt Builder</a>
    </div>

  </div>

    <PricingSection client:load priceIds={{
      starterMonthly: import.meta.env.STRIPE_PRICE_STARTER_MONTHLY,
      starterYearly: import.meta.env.STRIPE_PRICE_STARTER_YEARLY,
      proMonthly: import.meta.env.STRIPE_PRICE_PRO_MONTHLY,
      proYearly: import.meta.env.STRIPE_PRICE_PRO_YEARLY,
      unlimitedMonthly: import.meta.env.STRIPE_PRICE_UNLIMITED_MONTHLY,
      unlimitedYearly: import.meta.env.STRIPE_PRICE_UNLIMITED_YEARLY,
    }} />
</Layout>
