---
export const prerender = false;
---
<html>
  <head><title>Signing in...</title></head>
  <body>
    <script>
      import { supabase } from '../../lib/supabaseClient';
      import {
        completeMergeIfPending,
        readOAuthError,
        recoverFromIdentityExists,
      } from '../../lib/authFlow';

      const params = new URL(window.location.href).searchParams;
      const code = params.get('code');
      const mergeToken = params.get('merge');

      // GoTrue may deliver the OAuth failure here in the query string or, when
      // it rejected the request before any provider hop (e.g. the authorize
      // phase), back at the site root in the hash fragment.
      const oauthError = readOAuthError();

      if (oauthError?.code === 'identity_already_exists') {
        // The provider identity belongs to an older account. Stage the
        // anonymous credits and sign in to that account instead.
        try {
          await recoverFromIdentityExists(); // redirects to the provider on success
        } catch {
          // fall through to home; staged token simply expires
        }
      } else if (!oauthError) {
        try {
          if (code) await supabase.auth.exchangeCodeForSession(code);
          if (mergeToken) await completeMergeIfPending(mergeToken);
        } catch {
          // fall through to home
        }
      }
      window.location.replace('/');
    </script>
  </body>
</html>
