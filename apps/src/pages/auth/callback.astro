---
export const prerender = false;
---
<html>
  <head><title>Signing in...</title></head>
  <body>
    <script>
      import { supabase } from '../../lib/supabaseClient';
      import {
        completeMergeIfPending,
        readOAuthError,
        recoverFromIdentityExists,
      } from '../../lib/authFlow';

      const params = new URL(window.location.href).searchParams;
      const code = params.get('code');
      const mergeToken = params.get('merge');

      const oauthError = readOAuthError();
      let didRedirect = false;

      async function run() {
        if (oauthError?.code === 'identity_already_exists') {
          // Provider identity belongs to another account — stage anon credits
          // and re-launch OAuth as a plain sign-in.
          try {
            didRedirect = await recoverFromIdentityExists();
          } catch {
            // fall through to home; staged row simply expires
          }
        } else if (!oauthError) {
          // Normal callback (fresh signup / sign-in): exchange the PKCE code
          // and, if this is the recovery hop, hand off staged credits.
          try {
            if (code) await supabase.auth.exchangeCodeForSession(code);
            if (mergeToken) await completeMergeIfPending(mergeToken);
          } catch {
            // fall through to home
          }
        } else {
          // Other OAuth errors (e.g. access_denied): clean the URL and send home.
          // No code to exchange.
        }
      }

      await run();
      // Don't clobber the provider redirect when recovery kicked off.
      if (!didRedirect) window.location.replace('/');
    </script>
  </body>
</html>
